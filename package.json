{
  "name": "visitor-recognizer",
  "version": "1.0.0",
  "private": true,
  "description": "Hosted web app that works with Ring cameras: arrival log with snapshots, plus optional opt-in recognition of people the customer enrolls themselves.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 \"build-test/test/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "author": "Aoi Corp <mussadrammeh@protonmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.10",
    "typescript": "^5.6.3"
  }
}
